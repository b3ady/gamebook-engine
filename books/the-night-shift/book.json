   "limit": {"value": 5, "ending": "E_ADMITTED", "hook_label": "If all five fields of your wristband are filled"}},
  {"name": "Rounds", "start": 0, "cap": 6, "boxes": true, "clock": true,
   "note": "Six boxes, 01:00 to 06:00, none ticked when you start. Tick the next box each time you come back to the Main Corridor from the Old Wing, the Basement or Maternity. When you tick 06:00, turn to the section the rules give.",
   "limit": {"value": 6, "ending": "E_ADMITTED"}}
 ],

